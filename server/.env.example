# Core server
NODE_ENV=development
# Integer from 1 to 65535.
PORT=5000
# Exact browser origin (scheme, host, and optional port); no path or trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
# 1-63 characters: start with a letter or number; then letters, numbers, underscores, or hyphens.
MONGODB_DATABASE=nutrilens

# Authentication
# Required: generate at least 64 random characters. Never use a placeholder in a running app.
JWT_SECRET=
# Digits followed by m, h, or d (for example: 15m, 1h, or 7d).
JWT_EXPIRES_IN=15m
COOKIE_NAME=nutrilens_session
# Integer from 10 to 14.
BCRYPT_ROUNDS=12

# Recipe providers
# Primary provider: bundled or gemini. Gemini is optional and falls back to bundled recipes.
RECIPE_PROVIDER=bundled
# Only bundled is currently supported as the fallback provider.
RECIPE_FALLBACK_PROVIDER=bundled
# Image provider: none or cloudflare. Cloudflare image generation is optional.
RECIPE_IMAGE_PROVIDER=none

# Optional Gemini recipe generation (required only when RECIPE_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Integer from 1000 to 30000 milliseconds.
GEMINI_TIMEOUT_MS=10000

# Optional Cloudflare Workers AI images (required only when RECIPE_IMAGE_PROVIDER=cloudflare)
# Exactly 32 hexadecimal characters when set.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Must use an @cf/owner/model identifier.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Integer from 1000 to 60000 milliseconds.
RECIPE_IMAGE_TIMEOUT_MS=20000
# Integer from 1 to 4.
RECIPE_IMAGE_CONCURRENCY=2

# Optional external food data
USDA_FDC_API_KEY=
# Lowercase country name using letters, spaces, or hyphens.
OPEN_FOOD_FACTS_COUNTRY=india
OPEN_FOOD_FACTS_USER_AGENT=NutriLens/0.1 (contact@example.com)
# Integer from 1000 to 20000 milliseconds.
FOOD_PROVIDER_TIMEOUT_MS=7000
